AUTH_SECRET=replace-with-a-long-random-secret-in-production
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL=A&L Trucking Logistics <notificaciones@your-verified-domain.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3100
DATABASE_URL=mysql://ayl_app:replace_me@127.0.0.1:3306/ayl_real
# preview: local queue only. resend: actual sending with a verified domain.
EMAIL_DELIVERY=preview
RESEND_WEBHOOK_SECRET=
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Enable only after confirming the production HTTPS domain and launch readiness.
SEO_INDEXABLE=false

# New reception photos only. Existing files and payment evidence remain readable in MySQL.
PHOTO_STORAGE=mysql
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set true only after disabling r2.dev AND public custom domains on this bucket.
R2_PRIVATE_CONFIRMED=false
# Optional public URL, used ONLY by the synthetic connectivity/privacy test.
R2_URL=
